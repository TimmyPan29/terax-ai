[
  {
    "name": "main window startup JS (eager modulepreload)",
    "path": [
      "dist/assets/main-*.js",
      "dist/assets/react-*.js",
      "dist/assets/radix-*.js",
      "dist/assets/alert-dialog-*.js"
    ],
    "limit": "540 KB",
    "gzip": true
  },
  {
    "name": "total client JS",
    "path": [
      "dist/assets/*.js"
    ],
    "limit": "2400 KB",
    "gzip": true
  },
  {
    "name": "client JS excluding Mermaid diagrams",
    "path": [
      "dist/assets/*.js",
      "!dist/assets/markdown-mermaid-*.js"
    ],
    "limit": "1550 KB",
    "gzip": true
  },
  {
    "name": "Mermaid diagram JS (loaded on demand)",
    "path": [
      "dist/assets/markdown-mermaid-*.js"
    ],
    "limit": "850 KB",
    "gzip": true
  },
  {
    "name": "Ghostty primary terminal JS (lazy entry and shared presentation)",
    "path": [
      "dist/assets/useGhosttyTerminalSession-*.js",
      "dist/assets/TerminalFitQueue-*.js",
      "dist/assets/ghostty-vt-*.js"
    ],
    "limit": "56 KB",
    "gzip": true
  },
  {
    "name": "Ghostty WebGL fallback JS (loaded on demand)",
    "path": [
      "dist/assets/WebGlTerminalSurface-*.js",
      "dist/assets/WebGlTerminalRuntime-*.js"
    ],
    "limit": "15 KB",
    "gzip": true
  },
  {
    "name": "Ghostty terminal WASM variants (one loaded per webview)",
    "path": [
      "dist/assets/ghostty-vt-*.wasm"
    ],
    "limit": "450 KB",
    "gzip": true
  }
]
