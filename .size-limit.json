[
  {
    "name": "main window startup JS (eager modulepreload)",
    "path": [
      "dist/assets/main-*.js",
      "dist/assets/react-*.js",
      "dist/assets/radix-*.js",
      "dist/assets/alert-dialog-*.js",
      "dist/assets/xterm-*.js"
    ],
    "limit": "540 KB",
    "gzip": true
  },
  {
    "name": "total client JS excluding lazy PDF renderer",
    "path": ["dist/assets/*.js", "!dist/assets/pdfjs-*.js"],
    "limit": "1500 KB",
    "gzip": true
  },
  {
    "name": "lazy PDF renderer JS",
    "path": ["dist/assets/pdfjs-*.js"],
    "limit": "185 KB",
    "gzip": true
  },
  {
    "name": "PDF worker",
    "path": ["dist/assets/pdf.worker.min-*.mjs"],
    "limit": "1300 KB",
    "brotli": false
  }
]
